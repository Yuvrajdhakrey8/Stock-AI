FROM public.ecr.aws/lambda/python:3.11

# Upgrade pip, setuptools, and wheel to ensure pre-compiled manylinux wheels are used
RUN pip install --no-cache-dir --upgrade pip setuptools wheel

# Install dependencies using pre-compiled binary wheels (no local compilation needed)
COPY requirements.txt ${LAMBDA_TASK_ROOT}/
RUN pip install --no-cache-dir --prefer-binary -r ${LAMBDA_TASK_ROOT}/requirements.txt

# Copy application source code
COPY main.py ${LAMBDA_TASK_ROOT}/
COPY services ${LAMBDA_TASK_ROOT}/services

# Set Mangum ASGI handler
CMD ["main.handler"]

